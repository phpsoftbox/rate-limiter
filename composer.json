{
    "name": "phpsoftbox/rate-limiter",
    "description": "Rate limiter component for the PhpSoftBox framework",
    "license": "MIT",
    "type": "library",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "ext-redis": "Required when RedisRateLimiter is used with the PhpRedis client."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\RateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\RateLimiter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
